    ("NGC5585", [0,1,3,5,8,10,12], [0,30,60,80,90,95,93], 98, 3.6),
]
def model(r, Vmax, rs):
    r = np.array(r, float)
    return Vmax * (1 - np.exp(-r / rs)) ** (1/1.8)

fig, axes = plt.subplots(2, 2, figsize=(10,8))
axes = axes.flatten()
colors = ['#1f77b4','#ff7f0e','#2ca02c','#d62728','#9467bd']
for pi in range(4):
    ax = axes[pi]
    group = data[pi*5:(pi+1)*5]
    for i, (name, r, v_obs, Vmax, rs) in enumerate(group):
        r = np.array(r, float); v_obs = np.array(v_obs, float)
        R2 = 1 - np.sum((v_obs - model(r, Vmax, rs))**2) / np.sum((v_obs - np.mean(v_obs))**2)
        c = colors[i]
        ax.plot(r, v_obs, 'o', color=c, markersize=4)
        rf = np.linspace(0, max(r), 80)
        ax.plot(rf, model(rf, Vmax, rs), '--', color=c, linewidth=1.5)
        ax.text(max(r)+0.5, model(np.array([max(r)]), Vmax, rs)[0], f"{name} {R2:.2f}", color=c, fontsize=7, va='center')
    ax.set_xlabel('Radius (kpc)', fontsize=9)
    ax.set_ylabel('Velocity (km/s)', fontsize=9)
    ax.set_title(f'Group {pi+1}: 5 Galaxies', fontsize=10)
    ax.set_xlim(0, 58)
    ax.grid(alpha=0.3)
fig.suptitle('Fractal Model: 20-Galaxy Fitting - No Legend, Names on Curves', fontsize=11)
plt.tight_layout()
plt.savefig('20_galaxy_NOLEGEND.png', dpi=200, bbox_inches='tight')
plt.show()

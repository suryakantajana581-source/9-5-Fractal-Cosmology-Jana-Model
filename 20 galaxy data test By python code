import matplotlib.pyplot as plt
data = [
    ("NGC2841", [0,2,5,10,15,20,30,40,50], [0,120,220,280,300,305,300,295,290], 310, 6.0),
    ("NGC3198", [0,2,5,10,15,20,25,30], [0,70,110,135,145,150,152,150], 155, 4.0),
    ("DDO154", [0,1,2,3,4,5,6,7,8], [0,10,20,30,38,43,47,49,50], 52, 3.5),
    ("NGC2403", [0,2,4,6,8,10,12,15], [0,70,110,125,132,135,135,134], 138, 2.5),
    ("NGC2903", [0,2,5,10,15,20,25], [0,110,170,195,200,202,200], 205, 3.0),
    ("NGC3621", [0,2,5,10,15,20,25], [0,70,115,140,150,152,150], 155, 4.5),
    ("NGC6503", [0,1,3,5,8,10,12], [0,55,95,110,118,120,119], 122, 2.8),
    ("NGC7814", [0,2,5,10,15,20,25], [0,120,190,220,230,232,230], 235, 3.2),
    ("UGC128", [0,2,5,10,15,20,25,30], [0,40,80,110,125,132,135,134], 138, 6.5),
    ("IC2574", [0,1,2,4,6,8,10], [0,20,45,65,75,82,85], 88, 4.0),
    ("NGC3521", [0,2,5,10,15,20,25], [0,90,160,200,215,220,218], 222, 3.5),
    ("NGC6946", [0,2,5,10,15,20,25], [0,80,150,180,195,200,198], 202, 4.0),
    ("NGC7331", [0,2,5,10,15,20,25,30], [0,100,170,220,240,245,243,240], 248, 4.2),
    ("NGC5055", [0,2,5,10,15,20,25,30], [0,95,165,195,210,215,212,210], 218, 4.0),
    ("NGC7793", [0,1,3,5,8,10,12], [0,45,85,105,115,118,117], 120, 3.0),
    ("NGC247", [0,2,4,6,8,10,12], [0,40,75,95,105,110,108], 112, 3.8),
